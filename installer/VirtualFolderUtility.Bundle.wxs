<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Bundle
    Name="Virtual Folder Utility"
    Version="1.2.0.0"
    Manufacturer="SM21-blip"
    UpgradeCode="464C5D49-75C4-42E8-A312-8DF585F16EBB"
    IconSourceFile="$(var.IconPath)">
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.HyperlinkLicense">
      <bal:WixStandardBootstrapperApplication
        xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
        LicenseUrl="https://github.com/SM21-blip/Survive-The-enemies/blob/main/LICENSE"
        SuppressOptionsUI="yes" />
    </BootstrapperApplicationRef>
    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" Compressed="yes" DisplayInternalUI="yes" />
    </Chain>
  </Bundle>
</Wix>
